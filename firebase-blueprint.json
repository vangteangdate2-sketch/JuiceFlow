{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user profile linking an authenticated Google account to their active family workspace.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "workspaceId", "createdAt", "updatedAt"]
    },
    "WorkspaceInvite": {
      "title": "WorkspaceInvite",
      "description": "Lookup map from a family invite code to a workspace ID so 2-3 family members can pair devices.",
      "type": "object",
      "properties": {
        "inviteCode": {
          "type": "string",
          "minLength": 6,
          "maxLength": 16,
          "pattern": "^[A-Z0-9]+$"
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["inviteCode", "workspaceId", "createdBy", "createdAt"]
    },
    "Workspace": {
      "title": "Workspace",
      "description": "Shared family beverage business workspace configuration and settings.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "location": {
          "type": "string",
          "maxLength": 120
        },
        "inviteCode": {
          "type": "string",
          "minLength": 6,
          "maxLength": 16,
          "pattern": "^[A-Z0-9]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "memberUids": {
          "type": "array",
          "description": "Bounded list (max 10) of family member UIDs with full access."
        },
        "currency": {
          "type": "string",
          "enum": ["KHR"]
        },
        "usdRate": {
          "type": "number"
        },
        "language": {
          "type": "string",
          "enum": ["en", "vi"]
        },
        "familyMembers": {
          "type": "array",
          "description": "Bounded list (max 10) of family operator display names."
        },
        "lowStockDefault": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "name",
        "location",
        "inviteCode",
        "ownerId",
        "memberUids",
        "currency",
        "usdRate",
        "language",
        "familyMembers",
        "lowStockDefault",
        "createdAt",
        "updatedAt"
      ]
    },
    "WorkspaceMember": {
      "title": "WorkspaceMember",
      "description": "Membership record granting full equal access to a family member within a workspace.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "inviteCode": {
          "type": "string",
          "minLength": 6,
          "maxLength": 16,
          "pattern": "^[A-Z0-9]+$"
        },
        "joinedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "inviteCode", "joinedAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Beverage product with KHR price and ingredient recipe for automatic consumption tracking.",
      "type": "object",
      "properties": {
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "memberUids": {
          "type": "array",
          "description": "Bounded list (max 10) of workspace member UIDs for secure list queries."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "nameVi": {
          "type": "string",
          "maxLength": 100
        },
        "category": {
          "type": "string",
          "enum": ["juice", "smoothie", "tea", "coffee", "specialty"]
        },
        "priceKhr": {
          "type": "number"
        },
        "imageUrl": {
          "type": "string",
          "maxLength": 200000
        },
        "active": {
          "type": "boolean"
        },
        "recipe": {
          "type": "array",
          "description": "Bounded list (max 20) of recipe items { ingredientId, quantity }."
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "workspaceId",
        "memberUids",
        "name",
        "nameVi",
        "category",
        "priceKhr",
        "imageUrl",
        "active",
        "recipe",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "Ingredient": {
      "title": "Ingredient",
      "description": "Raw ingredient or packaging item tracked in inventory with unit cost in KHR.",
      "type": "object",
      "properties": {
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "memberUids": {
          "type": "array"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "nameVi": {
          "type": "string",
          "maxLength": 100
        },
        "unit": {
          "type": "string",
          "enum": ["g", "kg", "ml", "L", "pcs"]
        },
        "stockQty": {
          "type": "number"
        },
        "reorderLevel": {
          "type": "number"
        },
        "unitCostKhr": {
          "type": "number"
        },
        "supplier": {
          "type": "string",
          "maxLength": 100
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "workspaceId",
        "memberUids",
        "name",
        "nameVi",
        "unit",
        "stockQty",
        "reorderLevel",
        "unitCostKhr",
        "supplier",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "Sale": {
      "title": "Sale",
      "description": "Customer beverage order with line items, KHR total, computed COGS, and terminal void lock.",
      "type": "object",
      "properties": {
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "memberUids": {
          "type": "array"
        },
        "orderNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "saleDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "items": {
          "type": "array",
          "description": "Bounded list (max 30) of sold beverage items."
        },
        "totalKhr": {
          "type": "number"
        },
        "cogsKhr": {
          "type": "number"
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["cash", "khqr", "aba", "wing"]
        },
        "customerName": {
          "type": "string",
          "maxLength": 80
        },
        "note": {
          "type": "string",
          "maxLength": 200
        },
        "recordedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "status": {
          "type": "string",
          "enum": ["completed", "voided"]
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "workspaceId",
        "memberUids",
        "orderNumber",
        "saleDate",
        "items",
        "totalKhr",
        "cogsKhr",
        "paymentMethod",
        "customerName",
        "note",
        "recordedBy",
        "status",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "Expense": {
      "title": "Expense",
      "description": "Business operational, ingredient purchase, or household/travel expense in KHR.",
      "type": "object",
      "properties": {
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "memberUids": {
          "type": "array"
        },
        "expenseDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "enum": ["ingredients", "packaging", "utilities", "rent", "equipment", "transport", "household", "travel", "other"]
        },
        "scope": {
          "type": "string",
          "enum": ["business", "household"]
        },
        "amountKhr": {
          "type": "number"
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["cash", "khqr", "aba", "wing"]
        },
        "vendor": {
          "type": "string",
          "maxLength": 100
        },
        "note": {
          "type": "string",
          "maxLength": 200
        },
        "linkedIngredientId": {
          "type": "string",
          "maxLength": 128
        },
        "recordedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "workspaceId",
        "memberUids",
        "expenseDate",
        "title",
        "category",
        "scope",
        "amountKhr",
        "paymentMethod",
        "vendor",
        "note",
        "linkedIngredientId",
        "recordedBy",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "StockMovement": {
      "title": "StockMovement",
      "description": "Audit log of ingredient stock purchases, automatic sale deductions, and manual adjustments.",
      "type": "object",
      "properties": {
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "memberUids": {
          "type": "array"
        },
        "ingredientId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ingredientName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "movementType": {
          "type": "string",
          "enum": ["purchase", "sale_consumption", "void_restore", "adjustment"]
        },
        "deltaQty": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "enum": ["g", "kg", "ml", "L", "pcs"]
        },
        "totalCostKhr": {
          "type": "number"
        },
        "referenceId": {
          "type": "string",
          "maxLength": 128
        },
        "movementDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "note": {
          "type": "string",
          "maxLength": 200
        },
        "recordedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "workspaceId",
        "memberUids",
        "ingredientId",
        "ingredientName",
        "movementType",
        "deltaQty",
        "unit",
        "totalCostKhr",
        "referenceId",
        "movementDate",
        "note",
        "recordedBy",
        "createdBy",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user workspace pointer isolated to the owning UID."
    },
    "/workspaceInvites/{inviteCode}": {
      "schema": { "$ref": "#/entities/WorkspaceInvite" },
      "description": "Invite code lookup for pairing 2-3 family members into one shared workspace."
    },
    "/workspaces/{workspaceId}": {
      "schema": { "$ref": "#/entities/Workspace" },
      "description": "Shared family beverage business workspace settings."
    },
    "/workspaces/{workspaceId}/members/{memberUid}": {
      "schema": { "$ref": "#/entities/WorkspaceMember" },
      "description": "Master gate membership documents for family members with equal full access."
    },
    "/workspaces/{workspaceId}/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Beverage product catalog and recipe definitions."
    },
    "/workspaces/{workspaceId}/ingredients/{ingredientId}": {
      "schema": { "$ref": "#/entities/Ingredient" },
      "description": "Ingredient and packaging inventory records."
    },
    "/workspaces/{workspaceId}/sales/{saleId}": {
      "schema": { "$ref": "#/entities/Sale" },
      "description": "Customer sales ledger and order line items."
    },
    "/workspaces/{workspaceId}/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/Expense" },
      "description": "Business operational, ingredient purchase, and household/travel expenses."
    },
    "/workspaces/{workspaceId}/stockMovements/{movementId}": {
      "schema": { "$ref": "#/entities/StockMovement" },
      "description": "Immutable stock movement audit log."
    }
  }
}
