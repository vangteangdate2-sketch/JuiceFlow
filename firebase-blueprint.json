{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user profile linking an authenticated account to their active family workspace.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "workspaceId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "workspaceId", "createdAt", "updatedAt"]
    },
    "WorkspaceInvite": {
      "title": "WorkspaceInvite",
      "description": "Lookup map from a family invite code to a workspace ID so 2-3 family members can pair devices.",
      "type": "object",
      "properties": {
        "inviteCode": { "type": "string", "minLength": 6, "maxLength": 16, "pattern": "^[A-Z0-9]+$" },
        "workspaceId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["inviteCode", "workspaceId", "createdBy", "createdAt"]
    },
    "Workspace": {
      "title": "Workspace",
      "description": "Shared family beverage business workspace configuration and settings.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "location": { "type": "string", "maxLength": 120 },
        "inviteCode": { "type": "string", "minLength": 6, "maxLength": 16, "pattern": "^[A-Z0-9]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "memberUids": { "type": "array", "description": "Bounded list (max 10) of family member UIDs with full access." },
        "currency": { "type": "string", "enum": ["KHR"] },
        "usdRate": { "type": "number" },
        "posExchangeRate": { "type": "number", "description": "Configurable POS cash exchange rate (KHR per 1 USD, default 4000)." },
        "language": { "type": "string", "enum": ["en", "vi"] },
        "familyMembers": { "type": "array", "description": "Bounded list (max 10) of family operator display names." },
        "lowStockDefault": { "type": "number" },
        "allowNegativeStock": { "type": "boolean" },
        "enableOpenFoodFactsLookup": { "type": "boolean" },
        "timezone": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "name", "location", "inviteCode", "ownerId", "memberUids",
        "currency", "usdRate", "language", "familyMembers", "lowStockDefault",
        "createdAt", "updatedAt"
      ]
    },
    "WorkspaceMember": {
      "title": "WorkspaceMember",
      "description": "Membership record granting full equal access to a family member within a workspace.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "inviteCode": { "type": "string", "minLength": 6, "maxLength": 16, "pattern": "^[A-Z0-9]+$" },
        "joinedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "inviteCode", "joinedAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Packaged, made-to-order, or prepared-stock product with barcodes, pricing, stock balance, variants, and versioned recipes.",
      "type": "object",
      "properties": {
        "workspaceId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "memberUids": { "type": "array" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "nameVi": { "type": "string", "maxLength": 100 },
        "brand": { "type": "string", "maxLength": 80 },
        "category": { "type": "string", "minLength": 1, "maxLength": 64 },
        "categoryId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "productType": { "type": "string", "enum": ["PACKAGED", "PREPARED_TO_ORDER", "PREPARED_STOCK"] },
        "priceKhr": { "type": "number" },
        "costPriceKhr": { "type": "number" },
        "markupPercent": { "type": "number" },
        "manualPriceOverride": { "type": "boolean" },
        "imageUrl": { "type": "string", "maxLength": 200000 },
        "active": { "type": "boolean" },
        "barcode": { "type": "string", "maxLength": 64 },
        "packagingBarcodes": { "type": "array", "description": "Bounded list (max 10) of carton/pack barcodes with unitsPerPack." },
        "stockQty": { "type": "number" },
        "reorderLevel": { "type": "number" },
        "unit": { "type": "string", "enum": ["g", "kg", "ml", "L", "pcs"] },
        "supplier": { "type": "string", "maxLength": 100 },
        "recipe": { "type": "array", "description": "Bounded list (max 25) of recipe items." },
        "recipeVersion": { "type": "number" },
        "variants": { "type": "array", "description": "Bounded list (max 10) of product size/flavor variants." },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "workspaceId", "memberUids", "name", "nameVi", "category",
        "priceKhr", "imageUrl", "active", "recipe", "createdBy", "createdAt", "updatedAt"
      ]
    },
    "BarcodeRecord": {
      "title": "BarcodeRecord",
      "description": "Universal barcode registry entry mapping exact string barcode identifiers (preserving leading zeros) to products, variants, or multi-unit cartons.",
      "type": "object",
      "properties": {
        "workspaceId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "memberUids": { "type": "array" },
        "code": { "type": "string", "minLength": 1, "maxLength": 64 },
        "format": { "type": "string", "enum": ["EAN_13", "EAN_8", "UPC_A", "UPC_E", "CODE_128", "QR_CODE", "INTERNAL"] },
        "productId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "variantId": { "type": "string", "maxLength": 64 },
        "packagingType": { "type": "string", "enum": ["unit", "pack", "carton", "variant"] },
        "label": { "type": "string", "maxLength": 80 },
        "unitsPerScan": { "type": "number" },
        "active": { "type": "boolean" },
        "source": { "type": "string", "enum": ["manufacturer", "internal", "open_food_facts"] },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "workspaceId", "memberUids", "code", "format", "productId",
        "packagingType", "label", "unitsPerScan", "active", "source",
        "createdBy", "createdAt", "updatedAt"
      ]
    },
    "Ingredient": {
      "title": "Ingredient",
      "description": "Raw ingredient or packaging item tracked in inventory with unit cost in KHR.",
      "type": "object",
      "properties": {
        "workspaceId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "memberUids": { "type": "array" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "nameVi": { "type": "string", "maxLength": 100 },
        "categoryId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "unit": { "type": "string", "enum": ["g", "kg", "ml", "L", "pcs"] },
        "stockQty": { "type": "number" },
        "reorderLevel": { "type": "number" },
        "unitCostKhr": { "type": "number" },
        "supplier": { "type": "string", "maxLength": 100 },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "workspaceId", "memberUids", "name", "nameVi", "unit",
        "stockQty", "reorderLevel", "unitCostKhr", "supplier",
        "createdBy", "createdAt", "updatedAt"
      ]
    },
    "Sale": {
      "title": "Sale",
      "description": "Customer POS order with immutable deduction snapshots, KHR totals, COGS, partial returns, and terminal void/refund locks.",
      "type": "object",
      "properties": {
        "workspaceId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "memberUids": { "type": "array" },
        "clientTxId": { "type": "string", "maxLength": 128 },
        "orderNumber": { "type": "string", "minLength": 1, "maxLength": 32 },
        "saleDate": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "items": { "type": "array", "description": "Bounded list (max 40) of sold items with deduction snapshots." },
        "subtotalKhr": { "type": "number" },
        "totalKhr": { "type": "number" },
        "refundedKhr": { "type": "number" },
        "netTotalKhr": { "type": "number" },
        "cogsKhr": { "type": "number" },
        "refundedCogsKhr": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["cash", "khqr", "aba", "wing"] },
        "cash_received_usd": { "type": "number", "description": "USD cash tendered by customer on cash sales, or null for digital payments." },
        "cash_received_khr": { "type": "number", "description": "KHR cash tendered by customer on cash sales, or null for digital payments." },
        "exchange_rate_used": { "type": "number", "description": "POS KHR-per-USD exchange rate applied at checkout for cash sales, or null for digital payments." },
        "change_given_khr": { "type": "number", "description": "Change given back to customer in KHR (rounded to nearest 100 KHR) for cash sales, or null for digital payments." },
        "customerName": { "type": "string", "maxLength": 80 },
        "note": { "type": "string", "maxLength": 200 },
        "recordedBy": { "type": "string", "minLength": 1, "maxLength": 80 },
        "status": { "type": "string", "enum": ["completed", "partially_returned", "refunded", "voided"] },
        "returns": { "type": "array", "description": "Bounded list (max 20) of partial return records." },
        "voidedAt": { "type": "string", "maxLength": 64 },
        "voidedBy": { "type": "string", "maxLength": 80 },
        "voidReason": { "type": "string", "maxLength": 200 },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "workspaceId", "memberUids", "orderNumber", "saleDate", "items",
        "totalKhr", "cogsKhr", "paymentMethod", "customerName", "note",
        "recordedBy", "status", "createdBy", "createdAt", "updatedAt"
      ]
    },
    "Expense": {
      "title": "Expense",
      "description": "Business operating or household/travel expense in KHR.",
      "type": "object",
      "properties": {
        "workspaceId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "memberUids": { "type": "array" },
        "expenseDate": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "category": { "type": "string", "enum": ["ingredients", "packaging", "utilities", "rent", "equipment", "transport", "household", "travel", "other"] },
        "scope": { "type": "string", "enum": ["business", "household"] },
        "amountKhr": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["cash", "khqr", "aba", "wing"] },
        "vendor": { "type": "string", "maxLength": 100 },
        "note": { "type": "string", "maxLength": 200 },
        "linkedIngredientId": { "type": "string", "maxLength": 128 },
        "isInventoryPurchase": { "type": "boolean" },
        "recordedBy": { "type": "string", "minLength": 1, "maxLength": 80 },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "workspaceId", "memberUids", "expenseDate", "title", "category",
        "scope", "amountKhr", "paymentMethod", "vendor", "note",
        "linkedIngredientId", "recordedBy", "createdBy", "createdAt", "updatedAt"
      ]
    },
    "Purchase": {
      "title": "Purchase",
      "description": "Inventory stock-in purchase record (cash outflow & valuation increase, separated from operating expenses).",
      "type": "object",
      "properties": {
        "workspaceId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "memberUids": { "type": "array" },
        "purchaseDate": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "itemId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "itemName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "itemClassification": { "type": "string", "enum": ["packaged", "ingredient", "prepared_stock"] },
        "quantity": { "type": "number" },
        "packCount": { "type": "number" },
        "unitsPerPack": { "type": "number" },
        "unit": { "type": "string", "enum": ["g", "kg", "ml", "L", "pcs"] },
        "totalCostKhr": { "type": "number" },
        "unitCostKhr": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["cash", "khqr", "aba", "wing"] },
        "supplier": { "type": "string", "maxLength": 100 },
        "barcodeScanned": { "type": "string", "maxLength": 64 },
        "note": { "type": "string", "maxLength": 200 },
        "recordedBy": { "type": "string", "minLength": 1, "maxLength": 80 },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "workspaceId", "memberUids", "purchaseDate", "itemId", "itemName",
        "itemClassification", "quantity", "unit", "totalCostKhr", "unitCostKhr",
        "paymentMethod", "supplier", "note", "recordedBy", "createdBy", "createdAt"
      ]
    },
    "StockMovement": {
      "title": "StockMovement",
      "description": "Immutable audit ledger of all packaged, ingredient, and prepared-stock inventory changes.",
      "type": "object",
      "properties": {
        "workspaceId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "memberUids": { "type": "array" },
        "itemId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "itemName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "itemClassification": { "type": "string", "enum": ["packaged", "ingredient", "prepared_stock"] },
        "ingredientId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ingredientName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "movementType": {
          "type": "string",
          "enum": [
            "opening_stock", "purchase", "sale_consumption",
            "batch_prep_in", "batch_prep_consume",
            "void_restore", "return_restore",
            "stock_count", "adjustment", "damaged", "expired"
          ]
        },
        "deltaQty": { "type": "number" },
        "unit": { "type": "string", "enum": ["g", "kg", "ml", "L", "pcs"] },
        "unitCostKhr": { "type": "number" },
        "totalCostKhr": { "type": "number" },
        "referenceId": { "type": "string", "maxLength": 128 },
        "movementDate": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "note": { "type": "string", "maxLength": 200 },
        "recordedBy": { "type": "string", "minLength": 1, "maxLength": 80 },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "workspaceId", "memberUids", "ingredientId", "ingredientName",
        "movementType", "deltaQty", "unit", "totalCostKhr", "referenceId",
        "movementDate", "note", "recordedBy", "createdBy", "createdAt"
      ]
    },
    "Category": {
      "title": "Category",
      "description": "User-editable category synced across Products, POS, Inventory, and Financial Reports.",
      "type": "object",
      "properties": {
        "workspaceId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "memberUids": { "type": "array" },
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "nameVi": { "type": "string", "maxLength": 64 },
        "scope": { "type": "string", "enum": ["product", "inventory", "both"] },
        "sortOrder": { "type": "number" },
        "isSystem": { "type": "boolean" },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "workspaceId", "memberUids", "name", "nameVi", "scope",
        "sortOrder", "isSystem", "createdBy", "createdAt", "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user workspace pointer isolated to the owning UID."
    },
    "/workspaceInvites/{inviteCode}": {
      "schema": { "$ref": "#/entities/WorkspaceInvite" },
      "description": "Invite code lookup for pairing 2-3 family members into one shared workspace."
    },
    "/workspaces/{workspaceId}": {
      "schema": { "$ref": "#/entities/Workspace" },
      "description": "Shared family beverage business workspace settings."
    },
    "/workspaces/{workspaceId}/members/{memberUid}": {
      "schema": { "$ref": "#/entities/WorkspaceMember" },
      "description": "Master gate membership documents for family members with equal full access."
    },
    "/workspaces/{workspaceId}/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Product catalog (Packaged, Made-to-Order, Prepared Stock) with variants, barcodes, and recipes."
    },
    "/workspaces/{workspaceId}/barcodes/{barcodeId}": {
      "schema": { "$ref": "#/entities/BarcodeRecord" },
      "description": "Deterministic Firestore barcode registry mapping exact string codes (preserving leading zeros) to products, variants, and cartons."
    },
    "/workspaces/{workspaceId}/ingredients/{ingredientId}": {
      "schema": { "$ref": "#/entities/Ingredient" },
      "description": "Raw ingredient and packaging inventory records."
    },
    "/workspaces/{workspaceId}/sales/{saleId}": {
      "schema": { "$ref": "#/entities/Sale" },
      "description": "Customer sales ledger, deduction snapshots, partial returns, and void records."
    },
    "/workspaces/{workspaceId}/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/Expense" },
      "description": "Business operating and household/travel expenses."
    },
    "/workspaces/{workspaceId}/purchases/{purchaseId}": {
      "schema": { "$ref": "#/entities/Purchase" },
      "description": "Immutable inventory purchase records for accurate cash flow reporting."
    },
    "/workspaces/{workspaceId}/stockMovements/{movementId}": {
      "schema": { "$ref": "#/entities/StockMovement" },
      "description": "Immutable stock movement audit ledger across all 3 inventory tiers."
    },
    "/workspaces/{workspaceId}/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Centralized editable categories for Products, POS, Inventory, and Reports."
    }
  }
}
