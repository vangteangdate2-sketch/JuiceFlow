rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Pillar 4.1: Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && (
        request.auth.token.email_verified == true ||
        request.auth.token.firebase.sign_in_provider == 'anonymous'
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidInviteCode(code) {
      return code is string && code.size() >= 6 && code.size() <= 16 && code.matches('^[A-Z0-9]+$');
    }

    function isValidDateStr(d) {
      return d is string && d.size() == 10 && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidMemberUids(uids) {
      return uids is list
        && uids.size() >= 1
        && uids.size() <= 10
        && uids[0] is string
        && request.auth.uid in uids;
    }

    function isValidFamilyNames(names) {
      return names is list
        && names.size() >= 1
        && names.size() <= 10
        && names[0] is string;
    }

    function isValidPaymentMethod(pm) {
      return pm is string && pm in ['cash', 'khqr', 'aba', 'wing'];
    }

    function isValidUnit(u) {
      return u is string && u in ['g', 'kg', 'ml', 'L', 'pcs'];
    }

    function isValidClassification(c) {
      return c is string && c in ['packaged', 'ingredient', 'prepared_stock'];
    }

    function isWorkspaceMember(workspaceId) {
      return exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid));
    }

    // --- Entity Validation Blueprints ---

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'workspaceId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'workspaceId', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && isValidId(data.workspaceId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWorkspaceInvite(data) {
      return data.keys().hasAll(['inviteCode', 'workspaceId', 'createdBy', 'createdAt'])
        && data.keys().hasOnly(['inviteCode', 'workspaceId', 'createdBy', 'createdAt'])
        && isValidInviteCode(data.inviteCode)
        && isValidId(data.workspaceId)
        && isValidId(data.createdBy)
        && data.createdBy == request.auth.uid
        && data.createdAt is timestamp;
    }

    function isValidWorkspace(data) {
      return data.keys().hasAll([
          'name', 'location', 'inviteCode', 'ownerId', 'memberUids',
          'currency', 'usdRate', 'language', 'familyMembers', 'lowStockDefault',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'name', 'location', 'inviteCode', 'ownerId', 'memberUids',
          'currency', 'usdRate', 'posExchangeRate', 'language', 'familyMembers', 'lowStockDefault',
          'allowNegativeStock', 'enableOpenFoodFactsLookup', 'timezone', 'createdAt', 'updatedAt'
        ])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.location is string && data.location.size() <= 120
        && isValidInviteCode(data.inviteCode)
        && isValidId(data.ownerId)
        && isValidMemberUids(data.memberUids)
        && data.currency == 'KHR'
        && data.usdRate is number && data.usdRate > 0 && data.usdRate <= 100000
        && (!('posExchangeRate' in data) || (data.posExchangeRate is number && data.posExchangeRate > 0 && data.posExchangeRate <= 100000))
        && data.language is string && data.language in ['en', 'vi', 'km']
        && isValidFamilyNames(data.familyMembers)
        && data.lowStockDefault is number && data.lowStockDefault >= 0 && data.lowStockDefault <= 1000000
        && (!('allowNegativeStock' in data) || data.allowNegativeStock is bool)
        && (!('enableOpenFoodFactsLookup' in data) || data.enableOpenFoodFactsLookup is bool)
        && (!('timezone' in data) || (data.timezone is string && data.timezone.size() <= 64))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWorkspaceMember(data) {
      return data.keys().hasAll(['uid', 'displayName', 'inviteCode', 'joinedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'inviteCode', 'joinedAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && isValidInviteCode(data.inviteCode)
        && data.joinedAt is timestamp;
    }

    function isValidProduct(data, workspaceId) {
      return data.keys().hasAll([
          'workspaceId', 'memberUids', 'name', 'nameVi', 'category',
          'priceKhr', 'imageUrl', 'active', 'recipe', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'workspaceId', 'memberUids', 'name', 'nameVi', 'brand', 'category', 'categoryId', 'productType',
          'priceKhr', 'costPriceKhr', 'markupPercent', 'manualPriceOverride', 'allowSingleUnitSale',
          'imageUrl', 'active', 'barcode', 'packagingBarcodes',
          'stockQty', 'reorderLevel', 'unit', 'supplier',
          'recipe', 'recipeVersion', 'variants',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.workspaceId == workspaceId
        && isValidMemberUids(data.memberUids)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.nameVi is string && data.nameVi.size() <= 100
        && (!('brand' in data) || (data.brand is string && data.brand.size() <= 80))
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 64
        && (!('categoryId' in data) || isValidId(data.categoryId))
        && (!('productType' in data) || (data.productType is string && data.productType in ['PACKAGED', 'PREPARED_TO_ORDER', 'PREPARED_STOCK']))
        && data.priceKhr is number && data.priceKhr >= 0 && data.priceKhr <= 100000000
        && (!('costPriceKhr' in data) || (data.costPriceKhr is number && data.costPriceKhr >= 0 && data.costPriceKhr <= 100000000))
        && (!('markupPercent' in data) || (data.markupPercent is number && data.markupPercent >= 0 && data.markupPercent <= 10000))
        && (!('manualPriceOverride' in data) || data.manualPriceOverride is bool)
        && (!('allowSingleUnitSale' in data) || data.allowSingleUnitSale is bool)
        && data.imageUrl is string && data.imageUrl.size() <= 200000
        && data.active is bool
        && (!('barcode' in data) || (data.barcode is string && data.barcode.size() <= 64))
        && (!('packagingBarcodes' in data) || (data.packagingBarcodes is list && data.packagingBarcodes.size() <= 10))
        && (!('stockQty' in data) || (data.stockQty is number && data.stockQty >= -1000000 && data.stockQty <= 100000000))
        && (!('reorderLevel' in data) || (data.reorderLevel is number && data.reorderLevel >= 0 && data.reorderLevel <= 100000000))
        && (!('unit' in data) || isValidUnit(data.unit))
        && (!('supplier' in data) || (data.supplier is string && data.supplier.size() <= 100))
        && data.recipe is list && data.recipe.size() <= 25
        && (data.recipe.size() == 0 || data.recipe[0] is map)
        && (!('recipeVersion' in data) || (data.recipeVersion is number && data.recipeVersion >= 1 && data.recipeVersion <= 10000))
        && (!('variants' in data) || (data.variants is list && data.variants.size() <= 10))
        && isValidId(data.createdBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBarcodeRecord(data, workspaceId) {
      return data.keys().hasAll([
          'workspaceId', 'memberUids', 'code', 'format', 'productId',
          'packagingType', 'label', 'unitsPerScan', 'active', 'source',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'workspaceId', 'memberUids', 'code', 'format', 'productId', 'variantId',
          'packagingType', 'label', 'unitsPerScan', 'active', 'source',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.workspaceId == workspaceId
        && isValidMemberUids(data.memberUids)
        && data.code is string && data.code.size() >= 1 && data.code.size() <= 64
        && data.format is string && data.format in ['EAN_13', 'EAN_8', 'UPC_A', 'UPC_E', 'CODE_128', 'QR_CODE', 'INTERNAL']
        && isValidId(data.productId)
        && (!('variantId' in data) || (data.variantId is string && data.variantId.size() <= 64))
        && data.packagingType is string && data.packagingType in ['unit', 'pack', 'carton', 'variant']
        && data.label is string && data.label.size() <= 80
        && data.unitsPerScan is number && data.unitsPerScan >= 1 && data.unitsPerScan <= 10000
        && data.active is bool
        && data.source is string && data.source in ['manufacturer', 'internal', 'open_food_facts']
        && isValidId(data.createdBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBarcodeRegistryRecord(data, workspaceId) {
      return data.keys().hasAll([
          'workspaceId', 'memberUids', 'code', 'format', 'itemType',
          'packagingType', 'label', 'unitsPerScan', 'active', 'source',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'workspaceId', 'memberUids', 'code', 'format', 'itemType',
          'productId', 'ingredientId', 'variantId',
          'packagingType', 'label', 'unitsPerScan', 'active', 'source',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.workspaceId == workspaceId
        && isValidMemberUids(data.memberUids)
        && data.code is string && data.code.size() >= 1 && data.code.size() <= 64
        && data.format is string && data.format in ['EAN_13', 'EAN_8', 'UPC_A', 'UPC_E', 'CODE_128', 'QR_CODE', 'INTERNAL']
        && data.itemType is string && data.itemType in ['product', 'ingredient']
        && (
          (
            data.itemType == 'product'
            && 'productId' in data
            && isValidId(data.productId)
            && !('ingredientId' in data)
            && (!('variantId' in data) || (data.variantId is string && data.variantId.size() <= 64))
          ) ||
          (
            data.itemType == 'ingredient'
            && 'ingredientId' in data
            && isValidId(data.ingredientId)
            && !('productId' in data)
            && !('variantId' in data)
          )
        )
        && data.packagingType is string && data.packagingType in ['unit', 'pack', 'carton', 'variant']
        && data.label is string && data.label.size() <= 80
        && data.unitsPerScan is number && data.unitsPerScan >= 1 && data.unitsPerScan <= 10000
        && data.active is bool
        && data.source is string && data.source in ['manufacturer', 'internal', 'open_food_facts']
        && isValidId(data.createdBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidIngredient(data, workspaceId) {
      return data.keys().hasAll([
          'workspaceId', 'memberUids', 'name', 'nameVi', 'unit',
          'stockQty', 'reorderLevel', 'unitCostKhr', 'supplier',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'workspaceId', 'memberUids', 'name', 'nameVi', 'categoryId', 'barcode', 'unit',
          'stockQty', 'reorderLevel', 'unitCostKhr', 'supplier',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.workspaceId == workspaceId
        && isValidMemberUids(data.memberUids)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.nameVi is string && data.nameVi.size() <= 100
        && (!('categoryId' in data) || isValidId(data.categoryId))
        && (!('barcode' in data) || (data.barcode is string && data.barcode.size() <= 64))
        && isValidUnit(data.unit)
        && data.stockQty is number && data.stockQty >= -1000000 && data.stockQty <= 100000000
        && data.reorderLevel is number && data.reorderLevel >= 0 && data.reorderLevel <= 100000000
        && data.unitCostKhr is number && data.unitCostKhr >= 0 && data.unitCostKhr <= 100000000
        && data.supplier is string && data.supplier.size() <= 100
        && isValidId(data.createdBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCategory(data, workspaceId) {
      return data.keys().hasAll([
          'workspaceId', 'memberUids', 'name', 'nameVi', 'scope',
          'sortOrder', 'isSystem', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'workspaceId', 'memberUids', 'name', 'nameVi', 'scope', 'color',
          'sortOrder', 'isSystem', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.workspaceId == workspaceId
        && isValidMemberUids(data.memberUids)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 64
        && data.nameVi is string && data.nameVi.size() <= 64
        && data.scope is string && data.scope in ['product', 'inventory', 'both']
        && (!('color' in data) || (data.color is string && data.color in ['emerald', 'amber', 'sky', 'teal', 'indigo', 'purple', 'orange', 'rose', 'lime', 'stone']))
        && data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 100000
        && data.isSystem is bool
        && isValidId(data.createdBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSale(data, workspaceId) {
      return data.keys().hasAll([
          'workspaceId', 'memberUids', 'orderNumber', 'saleDate', 'items',
          'totalKhr', 'cogsKhr', 'paymentMethod', 'customerName', 'note',
          'recordedBy', 'status', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'workspaceId', 'memberUids', 'clientTxId', 'orderNumber', 'saleDate', 'items',
          'subtotalKhr', 'totalKhr', 'refundedKhr', 'netTotalKhr', 'cogsKhr', 'refundedCogsKhr',
          'paymentMethod', 'cash_received_usd', 'cash_received_khr', 'exchange_rate_used', 'change_given_khr',
          'customerName', 'note', 'recordedBy', 'status',
          'returns', 'voidedAt', 'voidedBy', 'voidReason',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.workspaceId == workspaceId
        && isValidMemberUids(data.memberUids)
        && (!('clientTxId' in data) || (data.clientTxId is string && data.clientTxId.size() <= 128))
        && data.orderNumber is string && data.orderNumber.size() >= 1 && data.orderNumber.size() <= 32
        && isValidDateStr(data.saleDate)
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 40 && data.items[0] is map
        && (!('subtotalKhr' in data) || (data.subtotalKhr is number && data.subtotalKhr >= 0 && data.subtotalKhr <= 1000000000))
        && data.totalKhr is number && data.totalKhr >= 0 && data.totalKhr <= 1000000000
        && (!('refundedKhr' in data) || (data.refundedKhr is number && data.refundedKhr >= 0 && data.refundedKhr <= data.totalKhr))
        && (!('netTotalKhr' in data) || (data.netTotalKhr is number && data.netTotalKhr >= 0 && data.netTotalKhr <= data.totalKhr))
        && data.cogsKhr is number && data.cogsKhr >= 0 && data.cogsKhr <= 1000000000
        && (!('refundedCogsKhr' in data) || (data.refundedCogsKhr is number && data.refundedCogsKhr >= 0 && data.refundedCogsKhr <= data.cogsKhr))
        && isValidPaymentMethod(data.paymentMethod)
        && (!('cash_received_usd' in data) || data.cash_received_usd == null || (data.cash_received_usd is number && data.cash_received_usd >= 0 && data.cash_received_usd <= 1000000))
        && (!('cash_received_khr' in data) || data.cash_received_khr == null || (data.cash_received_khr is number && data.cash_received_khr >= 0 && data.cash_received_khr <= 1000000000))
        && (!('exchange_rate_used' in data) || data.exchange_rate_used == null || (data.exchange_rate_used is number && data.exchange_rate_used > 0 && data.exchange_rate_used <= 100000))
        && (!('change_given_khr' in data) || data.change_given_khr == null || (data.change_given_khr is number && data.change_given_khr >= 0 && data.change_given_khr <= 1000000000))
        && data.customerName is string && data.customerName.size() <= 80
        && data.note is string && data.note.size() <= 200
        && data.recordedBy is string && data.recordedBy.size() >= 1 && data.recordedBy.size() <= 80
        && data.status is string && data.status in ['completed', 'partially_returned', 'refunded', 'voided']
        && (!('returns' in data) || (data.returns is list && data.returns.size() <= 20))
        && (!('voidedAt' in data) || (data.voidedAt is string && data.voidedAt.size() <= 64))
        && (!('voidedBy' in data) || (data.voidedBy is string && data.voidedBy.size() <= 80))
        && (!('voidReason' in data) || (data.voidReason is string && data.voidReason.size() <= 200))
        && isValidId(data.createdBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidExpense(data, workspaceId) {
      return data.keys().hasAll([
          'workspaceId', 'memberUids', 'expenseDate', 'title', 'category',
          'scope', 'amountKhr', 'paymentMethod', 'vendor', 'note',
          'linkedIngredientId', 'recordedBy', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'workspaceId', 'memberUids', 'expenseDate', 'title', 'category',
          'scope', 'amountKhr', 'paymentMethod', 'vendor', 'note',
          'linkedIngredientId', 'isInventoryPurchase', 'recordedBy', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.workspaceId == workspaceId
        && isValidMemberUids(data.memberUids)
        && isValidDateStr(data.expenseDate)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.category is string && data.category in [
          'ingredients', 'packaging', 'utilities', 'rent',
          'equipment', 'transport', 'household', 'travel', 'other'
        ]
        && data.scope is string && data.scope in ['business', 'household']
        && data.amountKhr is number && data.amountKhr >= 0 && data.amountKhr <= 1000000000
        && isValidPaymentMethod(data.paymentMethod)
        && data.vendor is string && data.vendor.size() <= 100
        && data.note is string && data.note.size() <= 200
        && data.linkedIngredientId is string && data.linkedIngredientId.size() <= 128
        && (!('isInventoryPurchase' in data) || data.isInventoryPurchase is bool)
        && data.recordedBy is string && data.recordedBy.size() >= 1 && data.recordedBy.size() <= 80
        && isValidId(data.createdBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPurchase(data, workspaceId) {
      return data.keys().hasAll([
          'workspaceId', 'memberUids', 'purchaseDate', 'itemId', 'itemName',
          'itemClassification', 'quantity', 'unit', 'totalCostKhr', 'unitCostKhr',
          'paymentMethod', 'supplier', 'note', 'recordedBy', 'createdBy', 'createdAt'
        ])
        && data.keys().hasOnly([
          'workspaceId', 'memberUids', 'purchaseDate', 'itemId', 'itemName',
          'itemClassification', 'quantity', 'packCount', 'unitsPerPack',
          'unit', 'totalCostKhr', 'unitCostKhr',
          'paymentMethod', 'supplier', 'barcodeScanned', 'note',
          'recordedBy', 'createdBy', 'createdAt'
        ])
        && data.workspaceId == workspaceId
        && isValidMemberUids(data.memberUids)
        && isValidDateStr(data.purchaseDate)
        && isValidId(data.itemId)
        && data.itemName is string && data.itemName.size() >= 1 && data.itemName.size() <= 100
        && isValidClassification(data.itemClassification)
        && data.quantity is number && data.quantity > 0 && data.quantity <= 10000000
        && (!('packCount' in data) || (data.packCount is number && data.packCount >= 0 && data.packCount <= 100000))
        && (!('unitsPerPack' in data) || (data.unitsPerPack is number && data.unitsPerPack >= 1 && data.unitsPerPack <= 10000))
        && isValidUnit(data.unit)
        && data.totalCostKhr is number && data.totalCostKhr >= 0 && data.totalCostKhr <= 1000000000
        && data.unitCostKhr is number && data.unitCostKhr >= 0 && data.unitCostKhr <= 100000000
        && isValidPaymentMethod(data.paymentMethod)
        && data.supplier is string && data.supplier.size() <= 100
        && (!('barcodeScanned' in data) || (data.barcodeScanned is string && data.barcodeScanned.size() <= 64))
        && data.note is string && data.note.size() <= 200
        && data.recordedBy is string && data.recordedBy.size() >= 1 && data.recordedBy.size() <= 80
        && isValidId(data.createdBy)
        && data.createdAt is timestamp;
    }

    function isValidStockMovement(data, workspaceId) {
      return data.keys().hasAll([
          'workspaceId', 'memberUids', 'ingredientId', 'ingredientName',
          'movementType', 'deltaQty', 'unit', 'totalCostKhr', 'referenceId',
          'movementDate', 'note', 'recordedBy', 'createdBy', 'createdAt'
        ])
        && data.keys().hasOnly([
          'workspaceId', 'memberUids', 'itemId', 'itemName', 'itemClassification',
          'ingredientId', 'ingredientName',
          'movementType', 'deltaQty', 'unit', 'unitCostKhr', 'totalCostKhr', 'referenceId',
          'movementDate', 'note', 'recordedBy', 'createdBy', 'createdAt'
        ])
        && data.workspaceId == workspaceId
        && isValidMemberUids(data.memberUids)
        && (!('itemId' in data) || isValidId(data.itemId))
        && (!('itemName' in data) || (data.itemName is string && data.itemName.size() >= 1 && data.itemName.size() <= 100))
        && (!('itemClassification' in data) || isValidClassification(data.itemClassification))
        && isValidId(data.ingredientId)
        && data.ingredientName is string && data.ingredientName.size() >= 1 && data.ingredientName.size() <= 100
        && data.movementType is string && data.movementType in [
          'opening_stock', 'purchase', 'sale_consumption',
          'batch_prep_in', 'batch_prep_consume',
          'void_restore', 'return_restore',
          'stock_count', 'adjustment', 'damaged', 'expired'
        ]
        && data.deltaQty is number && data.deltaQty >= -10000000 && data.deltaQty <= 10000000
        && isValidUnit(data.unit)
        && (!('unitCostKhr' in data) || (data.unitCostKhr is number && data.unitCostKhr >= 0 && data.unitCostKhr <= 100000000))
        && data.totalCostKhr is number && data.totalCostKhr >= 0 && data.totalCostKhr <= 1000000000
        && data.referenceId is string && data.referenceId.size() <= 128
        && isValidDateStr(data.movementDate)
        && data.note is string && data.note.size() <= 200
        && data.recordedBy is string && data.recordedBy.size() >= 1 && data.recordedBy.size() <= 80
        && isValidId(data.createdBy)
        && data.createdAt is timestamp;
    }

    // --- Collection Rules ---

    // 1. User Profile (PII isolated to owner)
    match /users/{userId} {
      allow get: if isVerified() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;
      allow create: if isVerified()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'workspaceId', 'updatedAt']);
      allow delete: if false;
    }

    // 2. Workspace Invite Codes (lookup only by exact code, no listing)
    match /workspaceInvites/{inviteCode} {
      allow get: if isVerified() && isValidInviteCode(inviteCode);
      allow list: if false;
      allow create: if isVerified()
        && isValidInviteCode(inviteCode)
        && isValidWorkspaceInvite(incoming())
        && incoming().inviteCode == inviteCode
        && incoming().createdAt == request.time
        && existsAfter(/databases/$(database)/documents/workspaces/$(incoming().workspaceId));
      allow update: if false;
      allow delete: if false;
    }

    // 3. Family Workspaces
    match /workspaces/{workspaceId} {
      allow get: if isVerified()
        && isValidId(workspaceId)
        && (request.auth.uid in existing().memberUids || isWorkspaceMember(workspaceId));
      allow list: if isVerified() && (request.auth.uid in resource.data.memberUids);
      allow create: if isVerified()
        && isValidId(workspaceId)
        && isValidWorkspace(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid));
      allow update: if isVerified()
        && isValidId(workspaceId)
        && isValidWorkspace(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            isWorkspaceMember(workspaceId)
            && incoming().inviteCode == existing().inviteCode
            && incoming().memberUids == existing().memberUids
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'location', 'usdRate', 'posExchangeRate', 'language', 'familyMembers',
              'lowStockDefault', 'allowNegativeStock', 'enableOpenFoodFactsLookup', 'timezone', 'updatedAt'
            ])
          ) ||
          (
            isWorkspaceMember(workspaceId)
            && incoming().inviteCode == existing().inviteCode
            && incoming().memberUids.hasAll(existing().memberUids)
            && incoming().memberUids.size() <= existing().memberUids.size() + 1
            && incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'familyMembers', 'updatedAt'])
          )
        );
      allow delete: if false;

      // 4. Workspace Members (Master Gate)
      match /members/{memberUid} {
        allow get: if isVerified()
          && isValidId(workspaceId)
          && isValidId(memberUid)
          && (request.auth.uid == memberUid || isWorkspaceMember(workspaceId));
        allow list: if false;
        allow create: if isVerified()
          && isValidId(workspaceId)
          && isValidId(memberUid)
          && request.auth.uid == memberUid
          && isValidWorkspaceMember(incoming())
          && incoming().joinedAt == request.time
          && (
            (
              existsAfter(/databases/$(database)/documents/workspaces/$(workspaceId))
              && getAfter(/databases/$(database)/documents/workspaces/$(workspaceId)).data.inviteCode == incoming().inviteCode
            ) ||
            (
              exists(/databases/$(database)/documents/workspaces/$(workspaceId))
              && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.inviteCode == incoming().inviteCode
            )
          );
        allow update: if false;
        allow delete: if false;
      }

      // 5. Products (Packaged, Made-to-Order, Prepared Stock)
      match /products/{productId} {
        allow get: if isVerified() && isValidId(workspaceId) && isValidId(productId) && isWorkspaceMember(workspaceId);
        allow list: if isVerified() && (request.auth.uid in resource.data.memberUids);
        allow create: if isVerified()
          && isValidId(workspaceId)
          && isValidId(productId)
          && isValidProduct(incoming(), workspaceId)
          && incoming().createdBy == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && isWorkspaceMember(workspaceId);
        allow update: if isVerified()
          && isValidId(workspaceId)
          && isValidId(productId)
          && isValidProduct(incoming(), workspaceId)
          && incoming().workspaceId == existing().workspaceId
          && incoming().createdBy == existing().createdBy
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && isWorkspaceMember(workspaceId)
          && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'nameVi', 'brand', 'category', 'categoryId', 'productType',
              'priceKhr', 'costPriceKhr', 'markupPercent', 'manualPriceOverride', 'allowSingleUnitSale',
              'imageUrl', 'active', 'barcode', 'packagingBarcodes',
              'stockQty', 'reorderLevel', 'unit', 'supplier',
              'recipe', 'recipeVersion', 'variants', 'updatedAt'
            ]) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['category', 'categoryId', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['stockQty', 'costPriceKhr', 'supplier', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['stockQty', 'updatedAt']) ||
            (
              incoming().memberUids.hasAll(existing().memberUids)
              && incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt'])
            )
          );
        allow delete: if isVerified() && isValidId(workspaceId) && isValidId(productId) && isWorkspaceMember(workspaceId);
      }

      // 5b. Universal Barcode Registry (Exact string IDs preserving leading zeros)
      match /barcodes/{barcodeId} {
        allow get: if isVerified() && isValidId(workspaceId) && isValidId(barcodeId) && isWorkspaceMember(workspaceId);
        allow list: if isVerified() && (request.auth.uid in resource.data.memberUids);
        allow create: if isVerified()
          && isValidId(workspaceId)
          && isValidId(barcodeId)
          && isValidBarcodeRecord(incoming(), workspaceId)
          && incoming().createdBy == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && isWorkspaceMember(workspaceId);
        allow update: if isVerified()
          && isValidId(workspaceId)
          && isValidId(barcodeId)
          && isValidBarcodeRecord(incoming(), workspaceId)
          && incoming().workspaceId == existing().workspaceId
          && incoming().code == existing().code
          && incoming().createdBy == existing().createdBy
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && isWorkspaceMember(workspaceId)
          && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'format', 'productId', 'variantId', 'packagingType',
              'label', 'unitsPerScan', 'active', 'source', 'updatedAt'
            ]) ||
            (
              incoming().memberUids.hasAll(existing().memberUids)
              && incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt'])
            )
          );
        allow delete: if isVerified() && isValidId(workspaceId) && isValidId(barcodeId) && isWorkspaceMember(workspaceId);
      }

      // 5c. Primary Cross-Item Barcode Registry (links scanned codes to productId OR ingredientId)
      match /barcodeRegistry/{barcodeId} {
        allow get: if isVerified() && isValidId(workspaceId) && isValidId(barcodeId) && isWorkspaceMember(workspaceId);
        allow list: if isVerified() && (request.auth.uid in resource.data.memberUids);
        allow create: if isVerified()
          && isValidId(workspaceId)
          && isValidId(barcodeId)
          && isValidBarcodeRegistryRecord(incoming(), workspaceId)
          && incoming().createdBy == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && isWorkspaceMember(workspaceId);
        allow update: if isVerified()
          && isValidId(workspaceId)
          && isValidId(barcodeId)
          && isValidBarcodeRegistryRecord(incoming(), workspaceId)
          && incoming().workspaceId == existing().workspaceId
          && incoming().code == existing().code
          && incoming().createdBy == existing().createdBy
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && isWorkspaceMember(workspaceId)
          && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'format', 'itemType', 'productId', 'ingredientId', 'variantId', 'packagingType',
              'label', 'unitsPerScan', 'active', 'source', 'updatedAt'
            ]) ||
            (
              incoming().memberUids.hasAll(existing().memberUids)
              && incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt'])
            )
          );
        allow delete: if isVerified() && isValidId(workspaceId) && isValidId(barcodeId) && isWorkspaceMember(workspaceId);
      }

      // 6. Ingredients & Raw Materials
      match /ingredients/{ingredientId} {
        allow get: if isVerified() && isValidId(workspaceId) && isValidId(ingredientId) && isWorkspaceMember(workspaceId);
        allow list: if isVerified() && (request.auth.uid in resource.data.memberUids);
        allow create: if isVerified()
          && isValidId(workspaceId)
          && isValidId(ingredientId)
          && isValidIngredient(incoming(), workspaceId)
          && incoming().createdBy == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && isWorkspaceMember(workspaceId);
        allow update: if isVerified()
          && isValidId(workspaceId)
          && isValidId(ingredientId)
          && isValidIngredient(incoming(), workspaceId)
          && incoming().workspaceId == existing().workspaceId
          && incoming().createdBy == existing().createdBy
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && isWorkspaceMember(workspaceId)
          && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'nameVi', 'categoryId', 'barcode', 'unit', 'stockQty', 'reorderLevel', 'unitCostKhr', 'supplier', 'updatedAt'
            ]) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['categoryId', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['stockQty', 'unitCostKhr', 'supplier', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['stockQty', 'unitCostKhr', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['stockQty', 'updatedAt']) ||
            (
              incoming().memberUids.hasAll(existing().memberUids)
              && incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt'])
            )
          );
        allow delete: if isVerified() && isValidId(workspaceId) && isValidId(ingredientId) && isWorkspaceMember(workspaceId);
      }

      // 7. Sales & Orders (with Terminal State Locking on voided & refunded)
      match /sales/{saleId} {
        allow get: if isVerified() && isValidId(workspaceId) && isValidId(saleId) && isWorkspaceMember(workspaceId);
        allow list: if isVerified() && (request.auth.uid in resource.data.memberUids);
        allow create: if isVerified()
          && isValidId(workspaceId)
          && isValidId(saleId)
          && isValidSale(incoming(), workspaceId)
          && incoming().status == 'completed'
          && incoming().createdBy == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && isWorkspaceMember(workspaceId);
        allow update: if isVerified()
          && isValidId(workspaceId)
          && isValidId(saleId)
          && isValidSale(incoming(), workspaceId)
          && incoming().workspaceId == existing().workspaceId
          && incoming().orderNumber == existing().orderNumber
          && incoming().totalKhr == existing().totalKhr
          && incoming().cogsKhr == existing().cogsKhr
          && incoming().createdBy == existing().createdBy
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && isWorkspaceMember(workspaceId)
          && (
            // Void transition from completed or partially_returned
            (
              existing().status in ['completed', 'partially_returned']
              && incoming().status == 'voided'
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'status', 'refundedKhr', 'netTotalKhr', 'refundedCogsKhr',
                'voidedAt', 'voidedBy', 'voidReason', 'updatedAt'
              ])
            ) ||
            // Partial or full return transition from completed or partially_returned
            (
              existing().status in ['completed', 'partially_returned']
              && incoming().status in ['partially_returned', 'refunded']
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'status', 'items', 'refundedKhr', 'netTotalKhr', 'refundedCogsKhr',
                'returns', 'updatedAt'
              ])
            ) ||
            // Family member UID propagation only (never mutates financial fields or status)
            (
              incoming().status == existing().status
              && incoming().memberUids.hasAll(existing().memberUids)
              && incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt'])
            )
          );
        allow delete: if false;
      }

      // 8. Operational & Household Expenses
      match /expenses/{expenseId} {
        allow get: if isVerified() && isValidId(workspaceId) && isValidId(expenseId) && isWorkspaceMember(workspaceId);
        allow list: if isVerified() && (request.auth.uid in resource.data.memberUids);
        allow create: if isVerified()
          && isValidId(workspaceId)
          && isValidId(expenseId)
          && isValidExpense(incoming(), workspaceId)
          && incoming().createdBy == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && isWorkspaceMember(workspaceId);
        allow update: if isVerified()
          && isValidId(workspaceId)
          && isValidId(expenseId)
          && isValidExpense(incoming(), workspaceId)
          && incoming().workspaceId == existing().workspaceId
          && incoming().createdBy == existing().createdBy
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && isWorkspaceMember(workspaceId)
          && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'expenseDate', 'title', 'category', 'scope', 'amountKhr',
              'paymentMethod', 'vendor', 'note', 'isInventoryPurchase', 'recordedBy', 'updatedAt'
            ]) ||
            (
              incoming().memberUids.hasAll(existing().memberUids)
              && incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt'])
            )
          );
        allow delete: if isVerified() && isValidId(workspaceId) && isValidId(expenseId) && isWorkspaceMember(workspaceId);
      }

      // 9. Inventory Purchases (Immutable Cash Outflow Records)
      match /purchases/{purchaseId} {
        allow get: if isVerified() && isValidId(workspaceId) && isValidId(purchaseId) && isWorkspaceMember(workspaceId);
        allow list: if isVerified() && (request.auth.uid in resource.data.memberUids);
        allow create: if isVerified()
          && isValidId(workspaceId)
          && isValidId(purchaseId)
          && isValidPurchase(incoming(), workspaceId)
          && incoming().createdBy == request.auth.uid
          && incoming().createdAt == request.time
          && isWorkspaceMember(workspaceId);
        allow update: if isVerified()
          && isValidId(workspaceId)
          && isValidId(purchaseId)
          && isValidPurchase(incoming(), workspaceId)
          && incoming().workspaceId == existing().workspaceId
          && incoming().createdBy == existing().createdBy
          && incoming().createdAt == existing().createdAt
          && isWorkspaceMember(workspaceId)
          && incoming().memberUids.hasAll(existing().memberUids)
          && incoming().diff(existing()).affectedKeys().hasOnly(['memberUids']);
        allow delete: if false;
      }

      // 10. Stock Movements (Immutable Audit Ledger across all 3 tiers)
      match /stockMovements/{movementId} {
        allow get: if isVerified() && isValidId(workspaceId) && isValidId(movementId) && isWorkspaceMember(workspaceId);
        allow list: if isVerified() && (request.auth.uid in resource.data.memberUids);
        allow create: if isVerified()
          && isValidId(workspaceId)
          && isValidId(movementId)
          && isValidStockMovement(incoming(), workspaceId)
          && incoming().createdBy == request.auth.uid
          && incoming().createdAt == request.time
          && isWorkspaceMember(workspaceId);
        allow update: if isVerified()
          && isValidId(workspaceId)
          && isValidId(movementId)
          && isValidStockMovement(incoming(), workspaceId)
          && incoming().workspaceId == existing().workspaceId
          && incoming().createdBy == existing().createdBy
          && incoming().createdAt == existing().createdAt
          && isWorkspaceMember(workspaceId)
          && incoming().memberUids.hasAll(existing().memberUids)
          && incoming().diff(existing()).affectedKeys().hasOnly(['memberUids']);
        allow delete: if false;
      }

      // 11. Centralized Editable Categories (Products, Inventory, POS & Reports)
      match /categories/{categoryId} {
        allow get: if isVerified() && isValidId(workspaceId) && isValidId(categoryId) && isWorkspaceMember(workspaceId);
        allow list: if isVerified() && (request.auth.uid in resource.data.memberUids);
        allow create: if isVerified()
          && isValidId(workspaceId)
          && isValidId(categoryId)
          && isValidCategory(incoming(), workspaceId)
          && incoming().createdBy == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && isWorkspaceMember(workspaceId);
        allow update: if isVerified()
          && isValidId(workspaceId)
          && isValidId(categoryId)
          && isValidCategory(incoming(), workspaceId)
          && incoming().workspaceId == existing().workspaceId
          && incoming().isSystem == existing().isSystem
          && incoming().createdBy == existing().createdBy
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && isWorkspaceMember(workspaceId)
          && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'nameVi', 'scope', 'color', 'sortOrder', 'updatedAt'
            ]) ||
            (
              incoming().memberUids.hasAll(existing().memberUids)
              && incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt'])
            )
          );
        allow delete: if isVerified()
          && isValidId(workspaceId)
          && isValidId(categoryId)
          && categoryId != 'uncategorized'
          && existing().isSystem != true
          && isWorkspaceMember(workspaceId);
      }
    }
  }
}
